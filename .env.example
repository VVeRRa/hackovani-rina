# Public storefront / content only.
# Scope this token to public content models and exclude contact submissions.
DATOCMS_READ_ONLY_API_TOKEN=

# Contact-form records only: public create + authenticated admin read/edit/publish.
# Restrict this token to the contact-form model.
DATOCMS_WRITE_API_TOKEN=

# Internal /admin login.
# Use a strong unique password and a high-entropy random session secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
